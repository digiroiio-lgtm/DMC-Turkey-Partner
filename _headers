/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# Force the correct sitemap protocol Content-Type on every sitemap file so that
# X-Content-Type-Options: nosniff (set above for /*) never causes crawlers to
# reject a sitemap because the host guessed the wrong MIME type.
/sitemap.xml
  Content-Type: application/xml; charset=utf-8

# NOTE: "/sitemap-*.xml" is NOT a valid pattern in Netlify/Cloudflare Pages
# _headers files -- the splat wildcard is only honored as a trailing path
# segment (e.g. "/sitemap/*"), never in the middle of a filename. Using it
# there silently matches nothing, so every child sitemap must be listed
# explicitly to guarantee it gets served with the correct XML Content-Type.
/sitemap-pages.xml
  Content-Type: application/xml; charset=utf-8

/sitemap-services.xml
  Content-Type: application/xml; charset=utf-8

/sitemap-destinations.xml
  Content-Type: application/xml; charset=utf-8

/sitemap-insights.xml
  Content-Type: application/xml; charset=utf-8

/sitemap-events.xml
  Content-Type: application/xml; charset=utf-8

/sitemap-selected-works.xml
  Content-Type: application/xml; charset=utf-8

/sitemap-event-costs.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate

/robots.txt
  Content-Type: text/plain; charset=utf-8
